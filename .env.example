# Server (Express API) env — copy to server/.env for local dev.
# On a host (Heroku et al.) set these as config vars instead; nothing here is read
# from the frontend repo, which has its own .env.example.
#
# DATABASE_URL and JWT_SECRET are required — the server refuses to start without
# them. FILES_S3_BUCKET and PUBLIC_API_URL are needed for photos and the logo;
# without them the server starts and warns. Everything else has a working
# default; the comments give it.

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. The PostgreSQL database the API serves from, as the API's OWN login
# (role `mb_api`): it can read and write rows and call functions, owns nothing,
# and its queries are cut off at 8 seconds. `pnpm railway:role` creates that
# login and writes this URL to infra/railway/.secrets.env.
#   postgresql://mb_api:<password>@<host>:<port>/<database>
DATABASE_URL=

# An ADMINISTRATOR connection to the same database, for the Prisma CLI
# (`prisma db pull`, `prisma migrate deploy`) and `pnpm db:catalog`. Not read
# by the running API; not needed on the host.
# DIRECT_DATABASE_URL=

# The most rows one read returns, whatever it asked for, and the size of the
# API's connection pool.
# DB_MAX_ROWS=1000
# DB_POOL_MAX=10

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# REQUIRED. The key access tokens are signed with. At least 32 characters of
# randomness, e.g. `openssl rand -base64 48`. Changing it signs everybody out.
JWT_SECRET=

# SMTP account the password reset link is sent through. Without it a reset link
# cannot be sent (the API says so); an administrator can still set a temporary
# password, and `pnpm auth:set-password <email>` works from the server.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Mountain Bakes <no-reply@example.com>"

# ─── Uploaded files (photo attachments, the branding logo) ────────────────────
# Stored in S3 under <FILES_S3_BUCKET>/<FILES_S3_PREFIX>/{attachments,branding}/;
# the logo is served from this API at /api/public/branding/. Uses
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION (under "Database
# backups" below). Without the two below the server starts and warns, in every
# environment, but screens that show photos (production orders, special orders)
# fail outright.
#
# REQUIRED for files. No fallback to the backup bucket on purpose. Before
# pointing this anywhere, check two things about the bucket:
#   * no Lifecycle rule expires objects under FILES_S3_PREFIX — the backup
#     rules delete by age, and a receipt photo deleted that way is gone;
#   * the IAM user may Put/Get/Delete under FILES_S3_PREFIX — the backup
#     policy is scoped to the backup prefix only and will be refused here.
# FILES_S3_BUCKET=
# FILES_S3_PREFIX=files

# REQUIRED for files. This API's own public origin, no trailing slash. The logo
# URL saved in settings is built from it, and that URL is loaded by signed-out
# login pages and printed receipts.
# PUBLIC_API_URL=https://api.example.com

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# PORT wins when set — hosts inject it themselves, so leave it alone locally.
# API_PORT is the local-dev fallback. With neither set the server listens on 3001.
# PORT=
API_PORT=3001

# Comma-separated browser origins allowed to call this API — scheme + host, no
# trailing slash, no path. Must match the web origin EXACTLY or the browser blocks
# the request with no server-side error to go on. localhost/127.0.0.1 are always
# allowed regardless. Falls back to NEXT_PUBLIC_WEB_URL, then http://localhost:3000;
# server.ts warns at boot if this is unset while NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000

# The web app's public origin. Read here only as the CORS_ORIGINS fallback, so it
# can be left unset if CORS_ORIGINS is spelled out. (The name is shared with the
# frontend's own copy of this variable — this is not a NEXT_PUBLIC_* leak.)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Set by the host in production. Controls two things: 5xx error bodies stop
# carrying internal detail (middleware/errorHandler.ts), and the CORS warning above
# becomes active. Leave unset locally.
# NODE_ENV=production

# ─── Outbound messaging (SMS / WhatsApp) ──────────────────────────────────────
# Shared by BOTH message types:
#   1. Daily closing summaries — 2 AM, to staff in notification_recipients.
#   2. Order confirmation SMS  — per order, to the customer's own number.
# One provider, one retry policy, one notification_logs table for both.
#
# With all of this unset the server runs the LOG provider: messages are written to
# the server log and recorded in notification_logs, but nothing reaches a real
# phone. That is a deliberate fallback, not a failure — a missing credential must
# never take down the nightly closing job or 500 an order — and the admin
# Notification Recipients page shows a "Test mode" banner while it is in effect.

# 'twilio' | 'log'. Leave unset to auto-detect: Twilio when its credentials below
# are complete, otherwise log. Setting 'twilio' with incomplete credentials logs a
# warning and still falls back.
# NOTIFICATION_PROVIDER=twilio

# Twilio credentials — Twilio Console -> Account Info. A provider is only
# considered configured when SID and token are both present AND at least one of the
# two senders is set; anything less falls back to the log provider.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS-capable Twilio number, E.164 with the leading +. REQUIRED for order
# confirmations — those are SMS-only (see below), so with this unset the provider
# is considered unconfigured and everything falls back to the log provider.
# TWILIO_SMS_FROM=+14155551234

# WhatsApp sender, E.164 — the code adds the `whatsapp:` prefix itself, so do NOT
# include it here. NOTE: outside a 24-hour customer-service window Meta only allows
# PRE-APPROVED TEMPLATE messages, and a daily closing summary is an unsolicited
# business-initiated message. In production the body must match an approved
# template or Twilio rejects it with error 63016.
# TWILIO_WHATSAPP_FROM=+14155238886

# Retry policy for a failed send. Attempt N waits NOTIFICATION_RETRY_DELAY_MS * N
# (linear backoff). maxAttempts counts the first try, so 3 = one send + two retries.
# NOTIFICATION_RETRY_MAX=3
# NOTIFICATION_RETRY_DELAY_MS=2000

# ─── Order confirmation SMS ───────────────────────────────────────────────────
# Sends the customer their order number and total when an order is placed
# (POST /api/orders) or a POS sale is rung up with a phone number
# (POST /api/orders/pos). Uses the Twilio config above.
#
# TWO switches must both be on for a message to leave the building:
#   1. Settings -> Order Confirmation SMS (settings.order_confirmations_enabled,
#      default FALSE) — the admin-facing toggle. Off means not even an attempt.
#   2. A working provider above. With no TWILIO_SMS_FROM the log provider takes
#      over and the message is logged, not sent.
#
# SMS only, not WhatsApp: outside a 24-hour customer-service window Meta requires
# a PRE-APPROVED TEMPLATE, and a confirmation to someone who has never messaged
# the business is exactly that case (Twilio error 63016).
#
# Each order gets at most ONE successful confirmation per channel, enforced by a
# partial unique index on notification_logs (migration 32) — a double-submit or a
# replayed request cannot bill a second SMS.

# Country code assumed for numbers stored without one — digits only, no '+'.
# Staff type numbers as '0300-1234567'; utils/phone.ts turns that into
# '+923001234567' before it reaches Twilio, which rejects non-E.164 with error
# 21211. Defaults to 92 (Pakistan), matching the Asia/Karachi business day.
# SMS_DEFAULT_COUNTRY_CODE=92

# ─── Login & Session Security ─────────────────────────────────────────────────
# All three are optional and all three have working defaults. Nothing here is a
# credential.
#
# GEOIP_ENABLED=false switches off the IP → country/city lookup entirely. The
# sessions and failed attempts are still recorded; their location columns stay
# null and the UI shows them as unresolved. Set it if sending staff IP addresses
# to a third party is not a trade you want to make — that IP is the ONLY thing
# sent, never the email, the role or the branch.
# GEOIP_ENABLED=true
#
# GEOIP_URL swaps the provider. A template with `{ip}` in it. The default is
# ipapi.co over HTTPS with no account and no key (~1,000 lookups a day, which
# this uses a small fraction of: one per NEW session, never per ping, cached per
# IP on top). The response is read under both ipapi.co's and ipinfo.io's field
# spellings, so those two and freeipapi.com have a fair chance of working
# unchanged. A lookup that fails, times out or is rate-limited never fails the
# login — the row is written with null geo columns.
# GEOIP_URL=https://ipapi.co/{ip}/json/
#
# LOGIN_SESSION_IDLE_MINUTES is how long a still-open session may go without
# checking in before Admin → Security shows it as Idle rather than Active.
# Default 6 (three missed pings); clamped between 1 and 10, since at 10 the
# session already reads as expired. It affects DISPLAY only — nothing is signed
# out, expired or blocked on this number.
# LOGIN_SESSION_IDLE_MINUTES=6

# ─── Seeding (pnpm seed only) ─────────────────────────────────────────────────
# Read solely by the seed script; the running server never looks at them. The
# defaults shown are the ones baked into scripts/seed.js — override them for
# anything you would not want to be public knowledge, and change the passwords
# immediately after seeding a real environment.
# SEED_ADMIN_EMAIL=admin@mountainbakes.com
# SEED_ADMIN_PASSWORD=Admin@123
# SEED_MANAGER_EMAIL=dha.manager@mountainbakes.com
# SEED_MANAGER_PASSWORD=Manager@123
# SEED_MANAGER2_EMAIL=gulshan.manager@mountainbakes.com
# SEED_MANAGER2_PASSWORD=Manager@123
# SEED_PRODUCTION_EMAIL=production@mountainbakes.com
# SEED_PRODUCTION_PASSWORD=Production@123

# ─── Database backups (pnpm backup:* only) ────────────────────────────────────
# Read ONLY by the backup commands (src/scripts/backup*.ts) and the super-admin
# /api/admin/backups endpoints — the running server boots fine with none of
# them set, and a backup endpoint answers 503 BACKUP_NOT_CONFIGURED instead of
# failing the process. Full account: docs/database-backup.md.
#
# The backup is a real PostgreSQL dump (pg_dump custom format) of the public
# and app schemas — every table, accounts and password hashes included —
# uploaded to s3://<BACKUP_S3_BUCKET>/<BACKUP_S3_PREFIX>/{daily,weekly,monthly,manual}/
# with SSE-S3 encryption, a SHA-256 checksum and an immutable JSON manifest.
# Retention is enforced by S3 Lifecycle rules: daily 7 days, weekly 35 days,
# monthly 366 days, manual 90 days.

# REQUIRED for any run. Off by default so a developer's `pnpm backup:daily`
# cannot write a dump of a dev database anywhere by accident.
# BACKUP_ENABLED=true

# REQUIRED for any run. What the backups dump: an ADMINISTRATOR connection to
# the database the API serves from — not DATABASE_URL, whose role owns nothing
# and is cut off after 8 seconds. Never logged, never stored in backup_jobs,
# never in a manifest.
# BACKUP_DB_URL=

# Standard AWS SDK credential vars for an IAM user scoped to the backup prefix
# only (policy in docs/database-backup.md). On a platform with an IAM role,
# leave both unset and the SDK default provider chain is used instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# No default on purpose — a wrong-but-present region produces a confusing SDK
# error rather than a clean "unset" failure. mountainbakes-bucket lives in
# ap-southeast-1.
# AWS_REGION=ap-southeast-1

# The destination bucket. Its own var (not a generic S3_BUCKET) so an unrelated
# S3 use can never be confused for backups. In production it MUST equal
# BACKUP_PRODUCTION_BUCKET (default mountainbakes-bucket); outside production
# it must NOT be that bucket unless BACKUP_ALLOW_PRODUCTION_BUCKET=true is set
# deliberately (use a test prefix with it). The legacy AWS_S3_BUCKET_NAME is
# read as a fallback with a warning.
# BACKUP_S3_BUCKET=mountainbakes-bucket
# BACKUP_PRODUCTION_BUCKET=mountainbakes-bucket
# BACKUP_ALLOW_PRODUCTION_BUCKET=false

# Key prefix inside the bucket. Everything the backup system writes lives under
# it: daily/ weekly/ monthly/ manual/ manifests/. `pnpm backup:integration`
# forces database-backups-test.
# BACKUP_S3_PREFIX=database-backups

# Business timezone the schedule and file names are computed in. Only
# Asia/Karachi is supported (shared/utils/timezone.ts is fixed to it).
# BACKUP_TIMEZONE=Asia/Karachi

# Retention, in days. These feed the S3 Lifecycle rules `pnpm backup:aws:configure`
# writes AND the retention_until recorded on every backup, so keep them in step
# with what is configured on the bucket. Each must be >= 1.
# BACKUP_DAILY_RETENTION_DAYS=7
# BACKUP_WEEKLY_RETENTION_DAYS=35
# BACKUP_MONTHLY_RETENTION_DAYS=366
# BACKUP_MANUAL_RETENTION_DAYS=90

# Who deletes expired backups. 'lifecycle' (default): S3 Lifecycle rules do,
# and `pnpm backup:retention` only reports. 'application': `pnpm backup:retention
# -- --confirm` deletes them itself (needs s3:DeleteObject). Never both.
# BACKUP_RETENTION_AUTHORITY=lifecycle

# A failed backup always opens a Support Center ticket + notifies super admins.
# Set true to ALSO text the admin recipients (notification_recipients,
# department=admin) over the configured SMS/WhatsApp provider.
# BACKUP_ALERT_MESSAGING=false

# A 'running' backup_jobs row older than this is treated as a dead run and
# superseded (dyno killed mid-dump). Default 90 minutes; minimum 1 minute.
# BACKUP_STALE_LOCK_MS=5400000

# pg_dump is killed after this. Default 30 minutes.
# BACKUP_PG_DUMP_TIMEOUT_MS=1800000

# Directory pg_dump/pg_restore/psql live in when they are not on PATH. On
# Heroku with the apt buildpack: /app/.apt/usr/lib/postgresql/18/bin
# PG_BIN_DIR=

# Where the dump is written before upload (deleted afterwards, success or not).
# Defaults to <os tmpdir>/mountainbakes-backups.
# BACKUP_TMP_DIR=

# Recorded in every manifest/ledger row. Defaults to heroku-<HEROKU_RELEASE_VERSION>
# when Heroku's dyno metadata is enabled, else null.
# APP_VERSION=

# ─── Restore drill (pnpm backup:restore:test only) ────────────────────────────
# An ISOLATED PostgreSQL database the drill restores into with pg_restore
# --clean. The script refuses the production host/database, anything that
# names the production server, and PRODUCTION=true. Local example:
#   postgresql://postgres:postgres@localhost:5432/mountainbakes_restore_test
# BACKUP_RESTORE_TEST_DB_URL=

# ─── Moving off Supabase (infra/railway only) ─────────────────────────────────
# Read ONLY by the one-off tools in infra/railway — the copy, its verification
# and the file copy. The running API reads none of these, and they can all be
# deleted once the move is finished and the Supabase project is closed.
#
# Where `pnpm railway:migrate` copies TO, what `railway:verify` compares, and
# where `railway:role` and `db:baseline` work: the ADMINISTRATOR connection to
# the new database. Deliberately not DATABASE_URL — the copy wipes its target.
# RAILWAY_DB_URL=
#
# What the copy reads FROM: Supabase's session pooler (port 5432).
# SUPABASE_DB_URL=
#
# What `pnpm files:copy` downloads the stored files with.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
