generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attachments {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity             attachment_entity
  entity_id          String?             @db.Uuid
  storage_path       String              @unique
  mime_type          String
  size_bytes         Int
  width              Int?
  height             Int?
  uploaded_by        String?             @db.Uuid
  uploaded_by_name   String?
  bound_at           DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  content_sha256     String?
  users              users?              @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
  production_returns production_returns?

  @@index([entity, entity_id], map: "attachments_entity_idx", where: raw("(entity_id IS NOT NULL)"))
  @@index([created_at], map: "attachments_orphan_idx", where: raw("(entity_id IS NULL)"))
  @@index([content_sha256], map: "attachments_sha256_idx", where: raw("(content_sha256 IS NOT NULL)"))
}

model audit_logs {
  id                                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacy_id                              String?    @unique
  action                                 String
  admin_id                               String?    @db.Uuid
  admin_name                             String?
  target_user_id                         String?    @db.Uuid
  target_user_name                       String?
  target_user_role                       user_role?
  details                                Json?
  created_at                             DateTime   @default(now()) @db.Timestamptz(6)
  users_audit_logs_admin_idTousers       users?     @relation("audit_logs_admin_idTousers", fields: [admin_id], references: [id], onUpdate: NoAction)
  users_audit_logs_target_user_idTousers users?     @relation("audit_logs_target_user_idTousers", fields: [target_user_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "audit_logs_created_idx")
  @@index([target_user_id], map: "audit_logs_target_idx", where: raw("(target_user_id IS NOT NULL)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auth_refresh_tokens {
  token_hash    String        @id
  session_id    String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  used_at       DateTime?     @db.Timestamptz(6)
  auth_sessions auth_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "auth_refresh_tokens_session_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auth_sessions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                @db.Uuid
  client              String                @default("web")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  last_used_at        DateTime              @default(now()) @db.Timestamptz(6)
  expires_at          DateTime              @db.Timestamptz(6)
  revoked_at          DateTime?             @db.Timestamptz(6)
  auth_refresh_tokens auth_refresh_tokens[]
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id], map: "auth_sessions_user_live_idx", where: raw("(revoked_at IS NULL)"))
}

