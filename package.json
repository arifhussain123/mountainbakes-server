{
  "name": "mountain-bakes-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "tsx --env-file .env scripts/seed.js",
    "purge:price-history": "tsx --env-file .env src/scripts/purge-price-history.ts",
    "purge:idempotency-keys": "tsx --env-file .env src/scripts/purge-idempotency-keys.ts",
    "purge:return-photos": "tsx --env-file .env src/scripts/purge-staged-return-photos.ts",
    "files:copy": "tsx --env-file .env infra/railway/copy-files.ts",
    "railway:migrate": "tsx --env-file .env infra/railway/migrate-data.ts",
    "railway:verify": "tsx --env-file .env infra/railway/verify-migration.ts",
    "railway:role": "tsx --env-file .env infra/railway/api-role.ts",
    "verify:idempotency": "tsx --env-file .env src/scripts/verify-idempotency.ts",
    "verify:login-identity": "tsx src/scripts/verify-login-identity.ts",
    "backup:daily": "tsx --env-file .env src/scripts/backup.ts daily",
    "backup:weekly": "tsx --env-file .env src/scripts/backup.ts weekly",
    "backup:monthly": "tsx --env-file .env src/scripts/backup.ts monthly",
    "backup:manual": "tsx --env-file .env src/scripts/backup.ts manual",
    "backup:status": "tsx --env-file .env src/scripts/backup.ts status",
    "backup:verify": "tsx --env-file .env src/scripts/backup.ts verify",
    "backup:list": "tsx --env-file .env src/scripts/backup.ts list",
    "backup:retention": "tsx --env-file .env src/scripts/backup.ts retention",
    "backup:restore:test": "tsx --env-file .env src/scripts/backup-restore-test.ts",
    "backup:aws:audit": "tsx --env-file .env src/scripts/backup-aws.ts audit",
    "backup:aws:configure": "tsx --env-file .env src/scripts/backup-aws.ts configure",
    "backup:test": "node --import tsx --test \"src/services/backup/__tests__/*.test.ts\"",
    "restrictions:test": "node --import tsx --test \"src/services/__tests__/*.test.ts\"",
    "prisma:pull": "prisma db pull && prisma generate",
    "prisma:generate": "prisma generate",
    "db:catalog": "tsx --env-file .env src/scripts/gen-db-catalog.ts",
    "db:baseline": "tsx --env-file .env infra/railway/db-baseline.ts",
    "db:test": "node --import tsx --test \"src/db/__tests__/*.test.ts\"",
    "auth:set-password": "tsx --env-file .env src/scripts/auth-set-password.ts",
    "user:change-email": "tsx --env-file .env src/scripts/user-change-email.ts",
    "backup:integration": "tsx --env-file .env src/scripts/backup-integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.15.2",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "7.10.0",
    "typescript": "^5.6.3"
  }
}
