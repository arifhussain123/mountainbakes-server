# Dependencies
node_modules/

# Build outputs
dist/
build/

# Turbo
.turbo/

# Secrets (NEVER commit) — any local credential/key files live here.
credentials/
.secrets/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Editor / tooling temp files
*.tmp.*
~$*

# Local AI agent tooling (installed per-developer via `npx skills add`)
.agents/
.claude/
skills-lock.json

# Foreign package-manager lockfiles. This repo is pnpm-only (see `packageManager`
# in package.json). A second lockfile makes the build guess the package manager,
# so an `npm install` run by mistake must not be committable.
package-lock.json
yarn.lock

# Railway migration: generated credentials and database dumps never go in git
infra/railway/.secrets.env
infra/railway/work/
*.dump
